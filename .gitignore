# Maven
target/
*.jar
!**/src/test/resources/**/*.jar

# IDE
.idea/
*.iml
.vscode/
*.iws
*.ipr

# OS
.DS_Store
Thumbs.db

# Local data — too large to track, lives outside the repo's commit history.
# Only fixtures under tests/ are allowed in the repo; everything else (raw
# datasets, baseline outputs, scratch CSVs) stays out of git history.
*.csv
!tests/**/*.csv

# Hadoop output / Spark work dirs
hadoop-*/
spark-warehouse/
metastore_db/
derby.log

# Hadoop FileSystem checksum sidecars next to fixture binaries — regenerated on
# every read/write, so we keep them out of git and let Hadoop recompute them.
tests/data/fixtures/.*.crc

# Logs and local run outputs
# log/ (单数) 是单机/集群脚本拉回的本地运行产物（counter、csv、metrics 等）
*.log
logs/
log/
tmp_stage3_in/

# Python baseline — local venv, bytecode, and run outputs (CSV is already
# covered above; this also catches Spark's _SUCCESS / .crc sidecars).
.venv/
__pycache__/
baseline/out/
